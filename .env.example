OBSIDIAN_VAULT_PATH=./tmp/demo-vault
INKRELAY_DATA_PATH=./tmp/inkrelay-data/raw
INKRELAY_PAPER_PROFILES_PATH=./tmp/inkrelay-data/paper-profiles.json
INKRELAY_NOTEBOOK_INSTANCES_PATH=./tmp/inkrelay-data/notebook-instances.json
INKRELAY_HOST=127.0.0.1
INKRELAY_PORT=4317
INKRELAY_PYTHON_SERVICE_URL=http://127.0.0.1:8321
INKRELAY_LANGUAGE_WORKER_URL=http://127.0.0.1:8321
INKRELAY_LANGUAGE_REVIEW_TIMEOUT_MS=3600000
INKRELAY_BLUETOOTH_ENABLED=true
SMARTPEN_DEFAULT_PAGE_WIDTH=1480
SMARTPEN_DEFAULT_PAGE_HEIGHT=2100

# Automatic paper geometry is local; saved manual profiles keep priority.
INKRELAY_AUTOMATIC_PAPER_ENABLED=true
INKRELAY_PAPER_DEFINITIONS_PATH=./tmp/inkrelay-data/paper-definitions.json

# Optional override for a separately packaged macOS Core Bluetooth executable.
# INKRELAY_MACOS_BLUETOOTH_HELPER=/path/to/InkRelayBluetooth
