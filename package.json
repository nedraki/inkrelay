{
  "name": "ink-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node scripts/build-native.mjs && tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "pnpm typecheck && node scripts/build-native.mjs && tsup apps/server/src/index.ts --format esm --platform node --out-dir apps/server/dist --sourcemap && vite build --config apps/web/vite.config.ts",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node --import tsx apps/server/src/demo.ts",
    "build:macos": "bash native/macos/build.sh",
    "publication:check": "node scripts/prepare-publication.mjs --check",
    "publication:prepare": "node scripts/prepare-publication.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "dbus-next": "^0.10.2",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "undici": "^8.10.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.19.0"
  }
}
